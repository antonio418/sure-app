# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Salidas de trabajo de Claude (CSV de leads con contactos reales, exportaciones, etc.).
# No versionar: evita borrados accidentales y que datos personales queden en el historial.
# Si algún día quieres versionar un archivo puntual de aquí, fuérzalo con: git add -f <ruta>
Claude outputs/
